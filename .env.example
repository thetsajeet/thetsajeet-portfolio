# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Contact environment selection. Defaults to development to prevent accidental
# production email during local testing. Set to "production" on final deployments.
CONTACT_ENVIRONMENT="development"

# Development/test inbox. Use a Resend test key or a development-only Resend
# key and a sender verified in that Resend account.
CONTACT_DEV_RESEND_API_KEY=""
CONTACT_DEV_EMAIL_FROM="Portfolio Dev <contact-dev@yourdomain.com>"
CONTACT_DEV_EMAIL_TO="your-dev-inbox@example.com"
CONTACT_DEV_UPSTASH_REDIS_REST_URL=""
CONTACT_DEV_UPSTASH_REDIS_REST_TOKEN=""

# Production credentials and inbox. Configure only in the final deployment
# environment; use a sender address on your production verified domain.
CONTACT_PROD_RESEND_API_KEY=""
CONTACT_PROD_EMAIL_FROM="Portfolio Contact <contact@yourdomain.com>"
CONTACT_PROD_EMAIL_TO="you@example.com"
CONTACT_PROD_UPSTASH_REDIS_REST_URL=""
CONTACT_PROD_UPSTASH_REDIS_REST_TOKEN=""
